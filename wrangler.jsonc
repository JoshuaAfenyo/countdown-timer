// Static site plus a small relay for the phone remote. Only /ws goes through the Worker; everything else is served from ./public.
{
  "name": "countdown-timer", // must match the Worker name in the Cloudflare dashboard
  "main": "src/worker.js",
  "compatibility_date": "2026-10-06",
  "keep_vars": true, // deploys keep variables and secrets you set in the dashboard
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/ws"] },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
  // The PIN is a secret named REMOTE_PIN. Set it in the dashboard (Settings, Variables and Secrets) or with: npx wrangler secret put REMOTE_PIN
}
